# Copy to .env (which is git-ignored) and adjust if needed.
# These values match docker-compose.yml at the repo root.
PORT=3000
DATABASE_URL=postgres://verso:verso@localhost:5432/verso

# Any random string of 32+ characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-or-more-random-characters
# The origin you open in the browser (Vite in development)
BETTER_AUTH_URL=http://localhost:5173

# Mailpit, from docker-compose.yml. Inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Verso <no-reply@verso.local>"
