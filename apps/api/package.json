    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@verso/shared": "*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
